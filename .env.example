# 复制本文件为 .env 并填入真实值：copy .env.example .env
# .env 已被 .gitignore 排除，绝不提交到代码库。

# ---- 视觉 AI 配置（默认 Moonshot Kimi，国内可直接访问）----
# 必填：你的 API Key。Moonshot 平台：https://platform.moonshot.cn/
AI_API_KEY=

# OpenAI 兼容接口地址（换成其他 provider 即可切换，例如通义/OpenAI）
AI_BASE_URL=https://api.moonshot.cn/v1

# 模型名（视觉识别使用 Kimi K3；如遇问题可临时回退 kimi-k2.6）
AI_MODEL=kimi-k3

# 单次视觉识别超时（秒）
AI_TIMEOUT_SECONDS=60

# ---- 上传与隐私 ----
# 单张图片最大字节数（10 MB）
MAX_UPLOAD_BYTES=10485760

# 上传文件落盘目录
UPLOAD_DIR=uploads

# 上传照片自动清理保留小时数（默认 24 小时）
UPLOAD_RETENTION_HOURS=24

# ---- 可选：匿名化计算日志（SQLite）----
STORAGE_ENABLED=false
STORAGE_PATH=logs/phenoage.db
